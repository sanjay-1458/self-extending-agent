# REQUIRED: Gemini / Google AI Studio key.
GOOGLE_API_KEY=replace_me

# Current recommended LangChain Google integration supports Gemini models.
# Change this if your account exposes a different model.
GEMINI_MODEL=gemini-3.7-flash

# REQUIRED: Redis is the primary persistent store for this demo.
# Local Docker default:
REDIS_URL=redis://localhost:6379

# REQUIRED if git_push=true in config/permissions.json.
# Use a PRIVATE repository. Example using SSH:
# GITHUB_REPO_URL=git@github.com:YOUR_USER/YOUR_PRIVATE_REPO.git
# Or HTTPS if your machine's Git credential manager is already authenticated.
GITHUB_REPO_URL=
GIT_REMOTE=origin
GIT_BRANCH=main

# OPTIONAL: Leave secrets OUT of source/config files.
# Add future service keys here when the agent reports BLOCKED_ON_ACCESS.
# Examples only:
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=

# Logging
LOG_LEVEL=debug

# Browser defaults
PLAYWRIGHT_HEADLESS=true
